{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orla Browser",
  "version": "0.1.0",
  "identifier": "app.orlabrowser.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run prepare:ui", "wait": true },
    "beforeBuildCommand": "npm run prepare:ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "orla",
        "title": "Orla Browser",
        "width": 1200,
        "height": 730,
        "minWidth": 460,
        "minHeight": 440,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
